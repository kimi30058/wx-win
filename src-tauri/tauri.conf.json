{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WxAutoDesktop",
  "version": "0.1.0",
  "identifier": "com.lyagent.wxauto-desktop",
  "build": {
    "beforeDevCommand": {
      "script": "pnpm dev",
      "cwd": ".."
    },
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": {
      "script": "pnpm build",
      "cwd": ".."
    },
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "WxAuto 微信自动化",
        "width": 1100,
        "height": 720,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ws://*:* wss://*:*; img-src 'self' data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "externalBin": ["binaries/wxauto-sidecar"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
